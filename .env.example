# AI Security Awareness Trainer - Environment Configuration
# Copy this file to .env and populate with appropriate values

# LLM Configuration (Provider options: openai, gemini, azure, mock)
LLM_PROVIDER=mock
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini

# Database Configuration
DATABASE_URL=sqlite:///./security_awareness.db

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change_me_in_production_32_chars
